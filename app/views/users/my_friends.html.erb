
<h1>Friends</h1>

<div class="search-area">
  <h3> Search Stocks </h3>

<%= form_tag search_stock_path, method: :get, data: {turbo_stream: true} do %>
    <div class="form-group row">
      <div class="col-sm-9 no-right-padding">
        <%= text_field_tag :friend, params[:friend], placeholder: "Search friends name or email",autofocus: true,  class: "form-control form-control-lg" %>
        
      </div>
      <div class="col-sm-3 no-left-padding">
        <%= button_tag type: :submit, class: "btn btn-success" do%>
          <%= fa_icon 'search 2x' %>
        <%end %>
      </div>
    </div>
  <% end %>
</div>



<div class=" mt-4">
  <% if !@friends.empty? %>
    <%= render 'friends/list' %>
  <% end %>
</div>