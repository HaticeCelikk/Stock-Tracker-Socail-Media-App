<%= turbo_stream.replace "results" do %>
  <div class="results-block">
    <%= render 'layouts/messages' %>
  </div>
  <% if @stock %>
    <div class="card card-header results-block">
      <strong>Symbol: </strong> <%= @stock.ticker %><br>
      <strong>Name: </strong> <%= @stock.name %><br>
      <strong>Price: </strong> <%= @stock.last_price %>
      <%= button_to 'Add to portfolio', user_stocks_path(user: current_user, ticker: @stock.ticker), class: "btn btn-success btn-lg rounded-pill shadow-sm", method: :post %>    </div>
  <% end %>
<% end %>
